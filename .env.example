# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8193
HOST=127.0.0.1

# MySQL connection. Local dev uses the docker compose database.
DATABASE_URL="mysql://lead_user:lead_password@127.0.0.1:3306/lead_distribution"

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-32-byte-random-string
JWT_EXPIRES_IN=7d

# Origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:8192

# Seeded admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# true only when running behind a reverse proxy, so visitor IPs are read
# from X-Forwarded-For instead of the proxy socket.
TRUST_PROXY=false

# Cookie the session token is stored in. Must match the frontend.
SESSION_COOKIE_NAME=lds_session
